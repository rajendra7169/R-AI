# Shell scripts must keep LF endings or they break on Linux/macOS.
*.sh        text eol=lf
*.command   text eol=lf

# Python tooling expects LF.
*.py        text eol=lf

# Web/UI sources we author here are also LF-canonical.
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.md        text eol=lf

# Windows-native scripts are CRLF-native.
*.bat       text eol=crlf
*.ps1       text eol=crlf
